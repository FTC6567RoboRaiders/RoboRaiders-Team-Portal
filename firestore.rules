rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApprovedUser() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserDoc().status == 'Approved';
    }

    function isMentorOrCaptain() {
      return isApprovedUser() && getUserDoc().role in ['mentor_captain', 'mentor', 'captain'];
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity Schema Validators
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'schoolEmail', 'schoolId', 'primarySubteam', 'secondarySubteam', 'role', 'status', 'createdAt'])
        && data.keys().size() >= 9 && data.keys().size() <= 30
        && data.id is string && data.id.size() <= 64
        && data.name is string && data.name.size() <= 128
        && data.schoolEmail is string && data.schoolEmail.size() <= 128
        && data.schoolId is string && data.schoolId.size() <= 128
        && data.primarySubteam is string
        && data.secondarySubteam is string
        && data.role is string
        && data.status is string
        && data.createdAt is number;
    }

    function isValidJournal(data) {
      return data.keys().hasAll(['id', 'subteam', 'author', 'date', 'planned', 'accomplished', 'problemsAndSolutions', 'planNextTime', 'images', 'createdAt', 'updatedAt', 'status'])
        && data.id is string
        && data.subteam is string
        && data.author is string
        && data.date is string
        && data.planned is string && data.planned.size() <= 50000
        && data.accomplished is string && data.accomplished.size() <= 50000
        && data.planNextTime is string && data.planNextTime.size() <= 50000
        && data.status in ['Draft', 'Pending Review', 'Approved', 'Needs Revision']
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function isValidTime(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'userEmail', 'subteam', 'date', 'startTime', 'endTime', 'durationHours', 'taskDescription', 'createdAt'])
        && data.id is string
        && data.userId is string
        && data.userName is string
        && data.userEmail is string
        && data.subteam is string
        && data.date is string
        && data.startTime is string
        && data.endTime is string
        && data.durationHours is number
        && data.taskDescription is string && data.taskDescription.size() <= 10000
        && data.createdAt is number;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'column', 'subteam', 'assignedTo', 'priority', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.id is string
        && data.title is string && data.title.size() <= 500
        && data.description is string && data.description.size() <= 10000
        && data.column in ['todo', 'inprogress', 'review', 'done']
        && data.subteam is string
        && data.assignedTo is string
        && data.priority in ['Low', 'Medium', 'High']
        && data.createdAt is number
        && data.updatedAt is number
        && data.updatedBy is string;
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['id', 'title', 'date', 'location', 'description', 'impactMetrics', 'hoursLogged', 'participants', 'images', 'creatorName', 'creatorEmail', 'createdAt', 'updatedAt', 'updatedBy'])
        && data.id is string
        && data.title is string && data.title.size() <= 500
        && data.location is string && data.location.size() <= 500
        && data.description is string && data.description.size() <= 10000
        && data.impactMetrics is string && data.impactMetrics.size() <= 10000
        && data.hoursLogged is number
        && data.participants is list
        && data.images is list
        && data.creatorName is string
        && data.creatorEmail is string
        && data.createdAt is number
        && data.updatedAt is number
        && data.updatedBy is string;
    }

    function isValidEmail(data) {
      return data.keys().hasAll(['id', 'from', 'to', 'subject', 'body', 'timestamp'])
        && data.id is string
        && data.from is string
        && data.to is string
        && data.subject is string
        && data.body is string
        && data.timestamp is number;
    }

    function isValidXpAdjustment(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'userEmail', 'amount', 'reason', 'awardedBy', 'awardedByEmail', 'createdAt'])
        && data.keys().size() >= 9 && data.keys().size() <= 15
        && data.id is string
        && data.userId is string
        && data.userName is string
        && data.userEmail is string
        && data.amount is number
        && data.reason is string && data.reason.size() <= 5000
        && data.awardedBy is string
        && data.awardedByEmail is string
        && data.createdAt is number;
    }

    function isValidLedgerTransaction(data) {
      return data.keys().hasAll(['id', 'amount', 'type', 'category', 'account', 'fundingSource', 'paidBy', 'description', 'date', 'createdBy', 'createdByEmail', 'createdAt'])
        && data.keys().size() >= 12 && data.keys().size() <= 20
        && data.id is string
        && data.amount is number
        && data.type in ['income', 'expense']
        && data.category in ['Parts & Hardware', 'Tools & Equipment', 'Travel & Lodging', 'Team Registration', 'Outreach & Marketing', 'Food & Catering', 'Other']
        && data.account in ['Self-Raised Funds', 'School Allocated Budget']
        && data.fundingSource in ['School Direct Payment', "Steve's Credit Card", 'Out-of-Pocket Reimbursement', 'Sponsor/Donation Check', 'Other']
        && data.paidBy is string && data.paidBy.size() <= 200
        && data.description is string && data.description.size() <= 5000
        && data.date is string
        && data.createdBy is string
        && data.createdByEmail is string
        && data.createdAt is number;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'type', 'createdAt', 'createdBy', 'active'])
        && data.keys().size() >= 7 && data.keys().size() <= 15
        && data.id is string
        && data.title is string && data.title.size() <= 200
        && data.message is string && data.message.size() <= 5000
        && data.type in ['info', 'warning', 'danger', 'success']
        && data.createdAt is number
        && data.createdBy is string
        && data.active is bool;
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'quantity', 'minQuantity', 'unit', 'location', 'status', 'condition', 'createdAt', 'createdBy', 'createdByEmail', 'updatedAt', 'updatedBy'])
        && data.keys().size() >= 14 && data.keys().size() <= 35
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 300
        && data.category in ['REV Robotics Parts', 'goBILDA & Motion', 'Electronics & Power', 'Hardware & Fasteners', 'Raw Stock & Materials', 'Tools & Equipment', 'Game Elements & Field', 'Consumables & Lab Supplies', 'Other']
        && data.quantity is number
        && data.minQuantity is number
        && data.unit is string && data.unit.size() <= 50
        && data.location is string && data.location.size() <= 200
        && data.status in ['In Stock', 'Low Stock', 'Out of Stock', 'Checked Out', 'Ordered', 'Damaged/Repair']
        && data.condition in ['New', 'Good', 'Fair', 'Damaged/Needs Repair', 'Retired']
        && data.createdAt is number
        && data.createdBy is string
        && data.createdByEmail is string
        && data.updatedAt is number
        && data.updatedBy is string;
    }

    function isValidInventoryTransaction(data) {
      return data.keys().hasAll(['id', 'itemId', 'itemName', 'type', 'quantityChanged', 'resultingQuantity', 'performedBy', 'performedByEmail', 'timestamp'])
        && data.keys().size() >= 9 && data.keys().size() <= 20
        && data.id is string && data.id.size() <= 128
        && data.itemId is string && data.itemId.size() <= 128
        && data.itemName is string && data.itemName.size() <= 300
        && data.type in ['check_out', 'check_in', 'restock', 'consume', 'audit_adjustment', 'damage_report']
        && data.quantityChanged is number
        && data.resultingQuantity is number
        && data.performedBy is string
        && data.performedByEmail is string
        && data.timestamp is number;
    }

    function isValidGrant(data) {
      return data.keys().hasAll(['id', 'name', 'organization', 'season', 'status', 'category', 'amountRequested', 'requirements', 'createdAt', 'createdBy', 'createdByEmail', 'updatedAt', 'updatedBy'])
        && data.id is string
        && data.name is string && data.name.size() <= 300
        && data.organization is string && data.organization.size() <= 300
        && data.season is string
        && data.status is string
        && data.category is string
        && data.amountRequested is number
        && data.createdAt is number
        && data.updatedAt is number;
    }

    // Collection Rules
    
    // 1. Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        isMentorOrCaptain() ||
        request.auth.uid == userId
      );
      allow delete: if isMentorOrCaptain();
    }

    // 2. Journal Entries
    match /journalEntries/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidJournal(request.resource.data);
      allow update: if isSignedIn() && (
        isMentorOrCaptain() ||
        isValidJournal(request.resource.data)
      );
      allow delete: if isMentorOrCaptain() || isSignedIn();
    }

    // 3. Time Entries
    match /timeEntries/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidTime(request.resource.data);
      allow update: if isSignedIn() && (
        isMentorOrCaptain() ||
        (resource.data.userEmail == request.auth.token.email 
         && isValidTime(request.resource.data)
         && request.resource.data.userEmail == resource.data.userEmail)
      );
      allow delete: if isMentorOrCaptain() || isSignedIn();
    }

    // 4. Kanban Tasks
    match /kanbanTasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidTask(request.resource.data);
      allow update: if isSignedIn() && isValidTask(request.resource.data);
      allow delete: if isSignedIn();
    }

    // 5. Outreach Events
    match /outreachEvents/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidEvent(request.resource.data);
      allow update: if isSignedIn() && isValidEvent(request.resource.data);
      allow delete: if isMentorOrCaptain() || isSignedIn();
    }

    // 6. Dispatched Emails
    match /dispatchedEmails/{emailId} {
      allow read: if true;
      allow create: if isValidEmail(request.resource.data);
      allow update: if isSignedIn() && isValidEmail(request.resource.data);
      allow delete: if isMentorOrCaptain() || isSignedIn();
    }
    
    // 7. XP Adjustments
    match /xpAdjustments/{adjId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidXpAdjustment(request.resource.data);
      allow update: if isSignedIn() && isValidXpAdjustment(request.resource.data);
      allow delete: if isMentorOrCaptain() || isSignedIn();
    }

    // 8. Ledger Transactions
    match /ledgerTransactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidLedgerTransaction(request.resource.data);
      allow update: if isSignedIn() && isValidLedgerTransaction(request.resource.data);
      allow delete: if isMentorOrCaptain() || isSignedIn();
    }

    // 9. System Settings
    match /systemSettings/{settingId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isMentorOrCaptain() || isSignedIn();
    }

    // 10. System Notifications
    match /systemNotifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidNotification(request.resource.data);
    }

    // 11. Inventory Items
    match /inventoryItems/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidInventoryItem(request.resource.data);
      allow update: if isSignedIn() && isValidInventoryItem(request.resource.data);
      allow delete: if isMentorOrCaptain() || isSignedIn();
    }

    // 12. Inventory Transactions
    match /inventoryTransactions/{txId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidInventoryTransaction(request.resource.data);
      allow update: if isSignedIn() && isValidInventoryTransaction(request.resource.data);
      allow delete: if isMentorOrCaptain() || isSignedIn();
    }

    // 13. Grant Applications
    match /grantApplications/{grantId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidGrant(request.resource.data);
      allow update: if isSignedIn() && isValidGrant(request.resource.data);
      allow delete: if isMentorOrCaptain() || isSignedIn();
    }
  }
}
